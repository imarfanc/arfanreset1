[
  {
    "id": "clt",
    "name": "Command Line Tools",
    "script": "install-clt.zsh",
    "optional": false,
    "guide": "install-command-line-tools.html"
  },
  {
    "id": "deno",
    "name": "Deno",
    "command": "curl -fsSL https://deno.land/install.sh | sh",
    "optional": false,
    "website": "https://deno.com/",
    "docs": "https://docs.deno.com/runtime/"
  },
  {
    "id": "uv",
    "name": "uv",
    "command": "curl -LsSf https://astral.sh/uv/install.sh | sh",
    "optional": false,
    "website": "https://astral.sh/uv",
    "docs": "https://docs.astral.sh/uv/"
  },
  {
    "id": "atuin",
    "name": "Atuin",
    "command": "curl --proto '=https' --tlsv1.2 -LsSf https://setup.atuin.sh | sh",
    "optional": false,
    "website": "https://atuin.sh/",
    "docs": "https://docs.atuin.sh/"
  },
  {
    "id": "claude",
    "name": "Claude Code",
    "command": "curl -fsSL https://claude.ai/install.sh | bash",
    "optional": false,
    "website": "https://claude.com/product/claude-code",
    "docs": "https://code.claude.com/docs/en/overview"
  },
  {
    "id": "codex",
    "name": "Codex CLI",
    "command": "curl -fsSL https://chatgpt.com/codex/install.sh | sh",
    "optional": false,
    "website": "https://chatgpt.com/codex",
    "docs": "https://developers.openai.com/codex/cli/"
  },
  {
    "id": "nvm",
    "name": "nvm",
    "command": "curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.8/install.sh | bash",
    "optional": false,
    "note": "Install nvm before Node.js. It manages Node.js versions, and the Node.js card needs it.",
    "website": "https://github.com/nvm-sh/nvm",
    "docs": "https://github.com/nvm-sh/nvm#usage"
  },
  {
    "id": "node",
    "name": "Node.js",
    "script": "install-node.sh",
    "optional": false,
    "note": "Needs nvm. Installs Node.js 26 and npm in a fresh login shell. If Terminal says nvm is not available, finish the nvm installer, then try again.",
    "website": "https://nodejs.org/",
    "docs": "https://nodejs.org/en/docs"
  },
  {
    "id": "bun",
    "name": "Bun",
    "command": "curl -fsSL https://bun.sh/install | bash",
    "optional": false,
    "website": "https://bun.sh/",
    "docs": "https://bun.sh/docs"
  },
  {
    "id": "opencode",
    "name": "OpenCode",
    "command": "curl -fsSL https://opencode.ai/v2/install | bash",
    "optional": false,
    "website": "https://opencode.ai/",
    "docs": "https://opencode.ai/docs/"
  },
  {
    "id": "install",
    "name": "Homebrew",
    "script": "install-homebrew.zsh",
    "optional": false,
    "guide": "install-homebrew.html"
  },
  {
    "id": "go-install",
    "name": "Go",
    "script": "install-go.sh",
    "optional": true
  },
  {
    "id": "zig-install",
    "name": "Zig",
    "script": "install-zig.sh",
    "optional": true
  },
  {
    "id": "rust-install",
    "name": "Rust",
    "command": "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh",
    "optional": true
  },
  {
    "id": "chrome",
    "name": "Google Chrome",
    "script": "install-chrome.sh",
    "optional": false,
    "website": "https://www.google.com/chrome/",
    "docs": "https://formulae.brew.sh/cask/google-chrome"
  }
]
